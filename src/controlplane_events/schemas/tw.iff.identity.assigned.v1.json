      "enum": [
        "level1",
        "level2"
      ],
      "title": "IffLevel",
      "type": "string"
    }
  },
  "$id": "urn:controlplane:event:tw.iff.identity.assigned.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
