            "tokens",
            "milliseconds",
            "access"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "AccountingQuantityV2",
      "type": "object"
    }
  },
  "$id": "urn:controlplane:event:accounting.reserved.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
