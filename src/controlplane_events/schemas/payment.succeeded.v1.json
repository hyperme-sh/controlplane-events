{
  "$id": "urn:controlplane:event:payment.succeeded.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "payment.succeeded.v1 \u2014 no card numbers; Stripe ids only.",
  "properties": {
    "amount_cents": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amount Cents"
    },
    "billing_record_id": {
      "format": "uuid",
      "title": "Billing Record Id",
      "type": "string"
    },
    "currency": {
      "anyOf": [
        {
          "maxLength": 8,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "stripe_payment_intent_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stripe Payment Intent Id"
    },
    "stripe_session_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stripe Session Id"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "user_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Id"
    }
  },
  "required": [
    "tenant_id",
    "billing_record_id"
  ],
  "title": "PaymentSucceededPayload",
  "type": "object",
  "x-event-type": "payment.succeeded.v1",
  "x-owner": "payment-service",
  "x-topic": "controlplane.events.v1"
}
