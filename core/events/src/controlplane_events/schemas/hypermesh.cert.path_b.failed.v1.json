      "enum": [
        "selling",
        "paused",
        "draining",
        "off",
        "n/a"
      ],
      "title": "SellState",
      "type": "string"
    }
  },
  "$id": "urn:controlplane:event:hypermesh.cert.path_b.failed.v1",
