{
  "$defs": {
    "JobKind": {
      "enum": [
        "path_b",
        "compact_cert",
        "lab_pull",
        "instance_check",
        "lease_start",
        "lease_stop",
        "sell_pause"
      ],
      "title": "JobKind",
      "type": "string"
    },
    "JobStatus": {
      "enum": [
        "pending",
        "passed",
        "failed"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "SellState": {
