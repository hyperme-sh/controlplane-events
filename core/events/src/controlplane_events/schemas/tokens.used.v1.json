{
  "$id": "urn:controlplane:event:tokens.used.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed payload for tokens.used.v1.",
  "properties": {
    "cost_usd": {
      "pattern": "^[+]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
      "title": "Cost Usd",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "model": {
      "maxLength": 256,
      "title": "Model",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "user_id": {
      "format": "uuid",
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "tenant_id",
    "model",
    "input_tokens",
    "output_tokens",
    "cost_usd"
  ],
  "title": "TokensUsedEvent",
  "type": "object",
  "x-event-type": "tokens.used.v1",
  "x-owner": "ai-service",
  "x-topic": "controlplane.events.v1"
}
